{
  "expo": {
    "name": "Brota Puebla",
    "slug": "brota-puebla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brota-icon.png",
    "scheme": "brota",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brota-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.brota.puebla"
    },
    "android": {
      "package": "com.brota.puebla",
      "adaptiveIcon": {
        "backgroundColor": "#FFFDF7",
        "foregroundImage": "./assets/images/brota-icon.png",
        "monochromeImage": "./assets/images/brota-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDF7",
          "image": "./assets/images/brota-icon.png",
          "imageWidth": 76,
          "android": {
            "image": "./assets/images/brota-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
